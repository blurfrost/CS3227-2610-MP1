<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.text.TextFlow?>

<VBox maxWidth="920.0" spacing="10.0" styleClass="page"
      xmlns="http://javafx.com/javafx/25.0.3"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="doggo.ui.javafx.OrganiseController">
    <Label styleClass="eyebrow" text="PLAN AHEAD" />
    <Label styleClass="page-title" text="Organise" />
    <Label styleClass="page-subtitle" text="Shape your upcoming journeys and itineraries."
           wrapText="true" />
    <GridPane hgap="18.0" maxWidth="Infinity" VBox.vgrow="ALWAYS">
        <columnConstraints>
            <ColumnConstraints maxWidth="Infinity" minWidth="0.0" percentWidth="50.0" />
            <ColumnConstraints maxWidth="Infinity" minWidth="0.0" percentWidth="50.0" />
        </columnConstraints>
        <rowConstraints>
            <RowConstraints vgrow="ALWAYS" />
        </rowConstraints>
        <VBox maxWidth="Infinity" minWidth="0.0" spacing="10.0" styleClass="dashboard-list-panel"
              GridPane.columnIndex="0" GridPane.hgrow="ALWAYS" GridPane.rowIndex="0" GridPane.vgrow="ALWAYS">
            <Label styleClass="panel-title" text="Your trips" />
            <Label styleClass="panel-subtitle" text="Select a trip to inspect its itinerary."
                   wrapText="true" />
            <ListView fx:id="tripList" styleClass="trip-list" VBox.vgrow="ALWAYS" />
            <Label fx:id="emptyState" managed="false" styleClass="empty-state"
                   text="No current or upcoming trips" visible="false" wrapText="true" />
        </VBox>
        <VBox maxWidth="Infinity" minWidth="0.0" spacing="12.0" styleClass="detail-panel"
              GridPane.columnIndex="1" GridPane.hgrow="ALWAYS" GridPane.rowIndex="0" GridPane.vgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <Label styleClass="panel-title" text="Trip details" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="statusLabel" managed="false" styleClass="status-badge"
                       text="UPCOMING" visible="false" />
            </HBox>
            <Separator />
            <Label fx:id="detailEmptyState" styleClass="empty-state"
                   text="Select a trip to inspect its details." wrapText="true" />
            <VBox fx:id="detailContent" maxWidth="Infinity" minWidth="0.0" managed="false" spacing="12.0" visible="false"
                  VBox.vgrow="ALWAYS">
                <TextFlow fx:id="detailTitleLabel" maxWidth="Infinity" minWidth="0.0">
                    <Text styleClass="detail-destination-text" text="Trip title" />
                </TextFlow>
                <Label fx:id="detailDatesLabel" styleClass="detail-schedule" text="Trip dates"
                       wrapText="true" />
                <HBox spacing="8.0">
                    <Button fx:id="editTripButton" disable="true" mnemonicParsing="false"
                            onAction="#handleEditTrip" styleClass="secondary-button" text="Edit trip" />
                    <Button fx:id="reviewTripButton" disable="true" mnemonicParsing="false"
                            onAction="#handleReviewTrip" styleClass="review-action-button" text="Add Review" />
                    <Button fx:id="deleteTripButton" disable="true" mnemonicParsing="false"
                            onAction="#handleDeleteTrip" styleClass="danger-button" text="Delete trip" />
                </HBox>
                <VBox fx:id="detailReviewCard" managed="false" maxHeight="200.0"
                      spacing="5.0" styleClass="review-card" visible="false">
                    <Label styleClass="review-heading" text="Trip Review" />
                    <ScrollPane fx:id="detailReviewScrollPane" fitToWidth="true" hbarPolicy="NEVER"
                                styleClass="review-scroll-pane" vbarPolicy="AS_NEEDED"
                                VBox.vgrow="ALWAYS">
                        <content>
                            <Label fx:id="detailReviewLabel" minHeight="-Infinity" styleClass="review-body"
                                   text="" wrapText="true" />
                        </content>
                    </ScrollPane>
                </VBox>
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <Label fx:id="plansLabel" styleClass="panel-title" text="Plans (0)" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button fx:id="addPlanButton" disable="true" mnemonicParsing="false"
                            onAction="#handleAddPlan" styleClass="primary-button"
                            text="+  Add plan" />
                </HBox>
                <ListView fx:id="planList" minHeight="90.0" styleClass="organise-plan-list" VBox.vgrow="ALWAYS" />
                <Label fx:id="planEmptyState" managed="false" styleClass="empty-state"
                       text="No plans have been added to this trip yet." visible="false" wrapText="true" />
            </VBox>
        </VBox>
    </GridPane>
    <padding>
        <Insets bottom="0.0" left="0.0" right="0.0" top="0.0" />
    </padding>
</VBox>
