<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox maxWidth="920.0" spacing="10.0" styleClass="page"
      xmlns="http://javafx.com/javafx/25.0.3"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="doggo.ui.javafx.OrganiseController">
    <HBox alignment="CENTER_LEFT" spacing="16.0">
        <VBox spacing="3.0" HBox.hgrow="ALWAYS">
            <Label styleClass="eyebrow" text="PLAN AHEAD" />
            <Label styleClass="page-title" text="Organise" />
            <Label styleClass="page-subtitle" text="Shape your upcoming journeys and itineraries."
                   wrapText="true" />
        </VBox>
        <Button disable="true" mnemonicParsing="false" styleClass="primary-button" text="+  New trip" />
    </HBox>
    <Label styleClass="prototype-hint" text="Trip and Plan actions will be available here next."
           wrapText="true" />
    <HBox spacing="18.0" VBox.vgrow="ALWAYS">
        <VBox minWidth="300.0" spacing="10.0" styleClass="dashboard-list-panel" HBox.hgrow="ALWAYS">
            <Label styleClass="panel-title" text="Your trips" />
            <Label styleClass="panel-subtitle" text="Select a trip to inspect its itinerary."
                   wrapText="true" />
            <ListView fx:id="tripList" styleClass="trip-list" VBox.vgrow="ALWAYS" />
            <Label fx:id="emptyState" managed="false" styleClass="empty-state"
                   text="No current or upcoming trips" visible="false" wrapText="true" />
        </VBox>
        <VBox minWidth="320.0" spacing="12.0" styleClass="detail-panel" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <Label styleClass="panel-title" text="Trip details" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="statusLabel" managed="false" styleClass="status-badge"
                       text="UPCOMING" visible="false" />
            </HBox>
            <Separator />
            <Label fx:id="detailEmptyState" styleClass="empty-state"
                   text="Select a trip to inspect its details." wrapText="true" />
            <VBox fx:id="detailContent" managed="false" spacing="12.0" visible="false"
                  VBox.vgrow="ALWAYS">
                <Label fx:id="detailTitleLabel" styleClass="detail-destination" text="Trip title"
                       wrapText="true" />
                <Label fx:id="detailDatesLabel" styleClass="detail-schedule" text="Trip dates"
                       wrapText="true" />
                <Label fx:id="detailSummaryLabel" styleClass="panel-subtitle" text="Trip summary"
                       wrapText="true" />
                <HBox spacing="8.0">
                    <Button disable="true" mnemonicParsing="false" styleClass="secondary-button"
                            text="Edit trip" />
                    <Button disable="true" mnemonicParsing="false" styleClass="primary-button"
                            text="+  Add plan" />
                </HBox>
                <Label styleClass="panel-title" text="Itinerary" />
                <ListView fx:id="planList" styleClass="organise-plan-list" VBox.vgrow="ALWAYS" />
                <Label fx:id="planEmptyState" managed="false" styleClass="empty-state"
                       text="No plans have been added to this trip yet." visible="false" wrapText="true" />
            </VBox>
        </VBox>
    </HBox>
    <padding>
        <Insets bottom="0.0" left="0.0" right="0.0" top="0.0" />
    </padding>
</VBox>
