<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.text.TextFlow?>

<VBox maxWidth="920.0" spacing="10.0" styleClass="page"
      xmlns="http://javafx.com/javafx/25.0.3"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="doggo.ui.javafx.GalleryController">
    <Label styleClass="eyebrow" text="LOOK BACK" />
    <Label styleClass="page-title" text="Gallery" />
    <Label styleClass="page-subtitle" text="Revisit the places and moments behind each trip."
           wrapText="true" />
    <GridPane hgap="18.0" maxWidth="Infinity" VBox.vgrow="ALWAYS">
        <columnConstraints>
            <ColumnConstraints maxWidth="Infinity" minWidth="0.0" percentWidth="50.0" />
            <ColumnConstraints maxWidth="Infinity" minWidth="0.0" percentWidth="50.0" />
        </columnConstraints>
        <rowConstraints>
            <RowConstraints vgrow="ALWAYS" />
        </rowConstraints>
        <VBox maxWidth="Infinity" minWidth="0.0" spacing="10.0" styleClass="dashboard-list-panel"
              GridPane.columnIndex="0" GridPane.hgrow="ALWAYS" GridPane.rowIndex="0" GridPane.vgrow="ALWAYS">
            <Label styleClass="panel-title" text="Past trips" />
            <Label styleClass="panel-subtitle" text="Select a trip to revisit its itinerary and review."
                   wrapText="true" />
            <ListView fx:id="tripList" styleClass="trip-list" VBox.vgrow="ALWAYS" />
            <Label fx:id="emptyState" managed="false" styleClass="empty-state"
                   text="No completed trips yet" visible="false" wrapText="true" />
        </VBox>
        <VBox maxWidth="Infinity" minWidth="0.0" spacing="12.0" styleClass="detail-panel"
              GridPane.columnIndex="1" GridPane.hgrow="ALWAYS" GridPane.rowIndex="0" GridPane.vgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <Label styleClass="panel-title" text="Trip details" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="statusLabel" managed="false" styleClass="status-badge"
                       text="COMPLETED" visible="false" />
            </HBox>
            <Separator />
            <Label fx:id="detailEmptyState" styleClass="empty-state"
                   text="Select a completed trip to inspect its details." wrapText="true" />
            <VBox fx:id="detailContent" maxWidth="Infinity" minWidth="0.0" managed="false" spacing="12.0" visible="false"
                  VBox.vgrow="ALWAYS">
                <TextFlow fx:id="detailTitleLabel" maxWidth="Infinity" minWidth="0.0">
                    <Text styleClass="detail-destination-text" text="Trip title" />
                </TextFlow>
                <Label fx:id="detailDatesLabel" styleClass="detail-schedule" text="Trip dates"
                       wrapText="true" />
                <Label fx:id="detailSummaryLabel" styleClass="panel-subtitle" text="Trip summary"
                       wrapText="true" />
                <HBox spacing="8.0">
                    <Button disable="true" mnemonicParsing="false" styleClass="secondary-button"
                            text="Edit trip" />
                    <Button fx:id="addPlanButton" disable="true" mnemonicParsing="false"
                            onAction="#handleAddPlan" styleClass="primary-button"
                            text="+  Add plan" />
                </HBox>
                <VBox spacing="5.0" styleClass="review-card">
                    <Label styleClass="review-heading" text="Trip review" />
                    <Label fx:id="detailReviewLabel" styleClass="review-body"
                           text="No review recorded yet." wrapText="true" />
                </VBox>
                <Label styleClass="panel-title" text="Itinerary" />
                <ListView fx:id="planList" styleClass="organise-plan-list" VBox.vgrow="ALWAYS" />
                <Label fx:id="planEmptyState" managed="false" styleClass="empty-state"
                       text="No plans were recorded for this trip." visible="false" wrapText="true" />
            </VBox>
        </VBox>
    </GridPane>
</VBox>
